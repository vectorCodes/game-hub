PORT=3100
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres. Use the pooler (transaction mode) connection string.
# Leave empty for local dev: an embedded Postgres (PGlite) is used in ./.pglite instead.
DATABASE_URL=

# Supabase project (used to verify auth tokens).
SUPABASE_URL=
# Only for legacy projects signing with the HS256 JWT secret; otherwise JWKS is used.
SUPABASE_JWT_SECRET=

# Where the browser loads models from. Local dev: served by this API at /models.
# Production: https://<project>.supabase.co/storage/v1/object/public/models
MODELS_BASE_URL=/models
